# Plantilla de las variables del panel. Se copia como `.env.local` y se completan los valores: ese archivo no
# se versiona porque lleva claves. Vite solo expone al navegador las variables que empiezan con `VITE_` y las
# hornea al compilar, así que hay que levantar el panel de nuevo después de tocar cualquiera de estas.

# --- Mapa de Google (pantalla Centro de control) ---

# Clave de la API de Maps JavaScript. Viaja al navegador: conviene restringirla por referente HTTP al dominio
# del panel y limitarla a la API de Maps JavaScript.
VITE_GOOGLE_MAPS_API_KEY=

# Id del mapa creado en Google Cloud Console. Es obligatorio: los pines nuevos (AdvancedMarker) no se dibujan
# sobre un mapa sin `mapId`.
VITE_GOOGLE_MAPS_MAP_ID=

# --- Firebase Realtime Database (posiciones en vivo de la flota) ---
# Salen de la configuración de la app web del proyecto de Firebase. Son las mismas que usan las dos apps.
# El panel solo escucha: el único que escribe es el servidor.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Ajustes de la pantalla Centro de control ---

# Cuántos segundos sin reportar posición marcan a una unidad como "sin señal" lo decide el servidor y viaja en
# `GET /operacion` (`sga.operacion.sin-senal-seg`): el panel no lo configura.

# Centro del mapa cuando ninguna unidad tiene posición todavía, normalmente la ciudad donde opera el servicio.
# Opcionales: sin ellas el mapa abre sobre Bolivia entera.
VITE_MAPA_LATITUD=
VITE_MAPA_LONGITUD=
